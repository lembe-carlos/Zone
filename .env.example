# Copiez ce fichier en ".env" et adaptez les valeurs (facultatif).
PORT=3000
# Compte administrateur créé au PREMIER démarrage uniquement.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est affiché une seule fois dans la fenêtre du serveur.
ADMIN_EMAIL=admin@carlosshop.com
ADMIN_PASSWORD=
# Dossier de la base de données et des photos (à sauvegarder !)
DATA_DIR=./data
# En ligne avec HTTPS : COOKIE_SECURE=true ; derrière un proxy (Render, Nginx...) : TRUST_PROXY=true
COOKIE_SECURE=auto
TRUST_PROXY=false
